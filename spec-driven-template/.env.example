# Environment variable template (Ch. 21 §21.6, Ch. 23 §23.3)
#
# RULES
# - Placeholders only. Never commit real credentials, tokens, or keys.
# - Every value here must also appear in 07-ops/environment-config.md with its purpose,
#   example value, and security note.
# - Values marked SECRET must never be printed in logs or error messages.

# --- Application ---
APP_ENV=local                       # local | test | production   (not secret)
APP_PORT=3000
APP_BASE_URL=http://localhost:3000

# --- Data ---
DATABASE_URL=<set_in_your_local_environment>          # SECRET in production

# --- Auth ---
JWT_SIGNING_KEY=<set_in_your_local_environment>       # SECRET — never log
SESSION_TIMEOUT_MINUTES=30

# --- Observability ---
LOG_LEVEL=info                      # info | warn | error  (avoid debug in production)

# --- Integrations ---
EMAIL_API_KEY=<set_in_your_local_environment>         # SECRET
EXTERNAL_CALL_TIMEOUT_SECONDS=5
EXTERNAL_CALL_MAX_RETRIES=2

# --- Feature flags ---
FEATURE_EXAMPLE_EXPORT=false
